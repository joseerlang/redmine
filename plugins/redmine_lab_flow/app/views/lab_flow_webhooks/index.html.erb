<h2><%= l(:label_webhooks) %></h2>

<% if @webhooks.any? %>
  <table class="list">
    <thead>
      <tr>
        <th><%= l(:field_name) %></th>
        <th><%= l(:label_event_type) %></th>
        <th><%= l(:field_url) %></th>
        <th><%= l(:field_active) %></th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @webhooks.each do |webhook| %>
        <tr class="<%= cycle('odd', 'even') %>">
          <td><%= link_to webhook.name, lab_flow_webhook_path(webhook) %></td>
          <td><%= l("label_event_#{webhook.event_type}") rescue webhook.event_type %></td>
          <td class="url"><code><%= truncate(webhook.url, length: 50) %></code></td>
          <td><%= webhook.active? ? l(:general_text_yes) : l(:general_text_no) %></td>
          <td class="buttons">
            <%= link_to l(:button_edit), edit_lab_flow_webhook_path(webhook), class: 'icon icon-edit' %>
            <%= link_to l(:button_delete), lab_flow_webhook_path(webhook), method: :delete, data: { confirm: l(:text_are_you_sure) }, class: 'icon icon-del' %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="nodata"><%= l(:label_no_data) %></p>
<% end %>

<p><%= link_to l(:label_webhook_new), new_lab_flow_webhook_path, class: 'icon icon-add' %></p>
