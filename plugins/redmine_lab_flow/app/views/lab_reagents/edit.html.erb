<h2><%= l(:label_reagent_edit) %></h2>

<%= form_tag(lab_reagent_path(@reagent), method: :patch) do %>
  <%= render partial: 'form' %>

  <p class="buttons">
    <%= submit_tag l(:button_save) %>
    <%= link_to l(:button_cancel), "/settings/plugin/redmine_lab_flow?tab=lab_reagents" %>
  </p>
<% end %>
