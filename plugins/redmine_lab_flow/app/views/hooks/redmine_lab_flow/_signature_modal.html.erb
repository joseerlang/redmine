<%# Phase 4: Electronic Signature Modal for status changes requiring attestation %>
<%# Only show for existing issues (not new ones) since signatures are only needed for status changes %>
<% if @issue && !@issue.new_record? && (@issue.assay? || @issue.sample?) %>
<div id="lab-flow-signature-modal" class="lab-flow-modal lab-flow-modal-hidden">
  <div class="lab-flow-modal-overlay"></div>
  <div class="lab-flow-modal-content">
    <div class="lab-flow-modal-header">
      <h3><%= I18n.t(:label_attestation) %></h3>
      <button type="button" class="lab-flow-modal-close">&times;</button>
    </div>
    <div class="lab-flow-modal-body">
      <div class="lab-flow-modal-help"><%= I18n.t(:text_signature_modal_help) %></div>

      <div class="lab-flow-signature-form">
        <%= hidden_field_tag 'signature_issue_id', @issue.id, id: 'signature_issue_id' %>

        <div class="lab-flow-form-group">
          <label for="signature_password"><%= I18n.t(:field_password) %> <span class="required">*</span></label>
          <input type="password" name="signature_password" id="signature_password" class="lab-flow-input" autocomplete="current-password" />
        </div>

        <div class="lab-flow-form-group">
          <label for="signature_meaning"><%= I18n.t(:label_signature_meaning) %> <span class="required">*</span></label>
          <select name="signature_meaning" id="signature_meaning" class="lab-flow-select">
            <option value=""><%= I18n.t(:label_please_select) %></option>
            <option value="authorship"><%= I18n.t(:label_signature_meaning_authorship) %></option>
            <option value="review"><%= I18n.t(:label_signature_meaning_review) %></option>
            <option value="approval"><%= I18n.t(:label_signature_meaning_approval) %></option>
          </select>
        </div>

        <div id="signature-error" class="lab-flow-error" style="display: none;"></div>
      </div>
    </div>
    <div class="lab-flow-modal-footer">
      <button type="button" class="lab-flow-btn lab-flow-btn-primary" id="signature-submit">
        <%= I18n.t(:button_submit) %>
      </button>
      <button type="button" class="lab-flow-btn lab-flow-btn-secondary" id="signature-cancel">
        <%= I18n.t(:button_cancel) %>
      </button>
    </div>
  </div>
</div>

<script>
  // Phase 4: Electronic Signature handling
  (function() {
    var signatureRequiredStatuses = <%= raw RedmineLabFlow::Setup::SIGNATURE_REQUIRED_STATUSES.map { |k| I18n.t(k) }.to_json %>;
    var verifyUrl = '<%= lab_flow_verify_signature_path %>';
    var pendingStatusChange = null;

    function isSignatureRequired(newStatusName) {
      return signatureRequiredStatuses.indexOf(newStatusName) !== -1;
    }

    function getModal() {
      return document.getElementById('lab-flow-signature-modal');
    }

    function showModal() {
      var modal = getModal();
      if (modal) {
        modal.classList.remove('lab-flow-modal-hidden');
        var passwordField = document.getElementById('signature_password');
        if (passwordField) {
          setTimeout(function() { passwordField.focus(); }, 100);
        }
      }
    }

    function hideModal() {
      var modal = getModal();
      if (modal) {
        modal.classList.add('lab-flow-modal-hidden');
      }
      var passwordField = document.getElementById('signature_password');
      if (passwordField) passwordField.value = '';
      var meaningField = document.getElementById('signature_meaning');
      if (meaningField) meaningField.value = '';
      var errorDiv = document.getElementById('signature-error');
      if (errorDiv) errorDiv.style.display = 'none';
    }

    function isModalVisible() {
      var modal = getModal();
      return modal && !modal.classList.contains('lab-flow-modal-hidden');
    }

    function showError(message) {
      var errorDiv = document.getElementById('signature-error');
      if (errorDiv) {
        errorDiv.textContent = message;
        errorDiv.style.display = 'block';
      }
    }

    function verifySignature(callback) {
      var password = document.getElementById('signature_password').value;
      var meaning = document.getElementById('signature_meaning').value;
      var issueId = document.getElementById('signature_issue_id').value;

      if (!password || !meaning) {
        showError('<%= I18n.t(:error_signature_fields_required) %>');
        return;
      }

      var csrfToken = document.querySelector('meta[name="csrf-token"]');
      var csrfParam = document.querySelector('meta[name="csrf-param"]');

      // Use form data instead of JSON to properly send session cookies
      var formData = new FormData();
      formData.append('issue_id', issueId);
      formData.append('password', password);
      formData.append('signature_meaning', meaning);
      formData.append('new_status', pendingStatusChange);
      if (csrfToken && csrfParam) {
        formData.append(csrfParam.content, csrfToken.content);
      }

      fetch(verifyUrl, {
        method: 'POST',
        credentials: 'include',
        headers: {
          'Accept': 'application/json',
          'X-Requested-With': 'XMLHttpRequest',
          'X-CSRF-Token': csrfToken ? csrfToken.content : ''
        },
        body: formData
      })
      .then(function(response) {
        if (!response.ok) {
          throw new Error('HTTP ' + response.status);
        }
        return response.json();
      })
      .then(function(data) {
        if (data.success) {
          hideModal();
          callback(true);
        } else {
          showError(data.error || '<%= I18n.t(:error_invalid_password) %>');
        }
      })
      .catch(function(error) {
        console.error('Signature verification error:', error);
        showError('<%= I18n.t(:error_signature_verification_failed) %>');
      });
    }

    function submitFormWithSignature() {
      verifySignature(function(success) {
        if (success) {
          var issueForm = document.getElementById('issue-form');
          if (issueForm) {
            // Add hidden field to indicate signature was verified
            var signatureVerified = document.createElement('input');
            signatureVerified.type = 'hidden';
            signatureVerified.name = 'signature_verified';
            signatureVerified.value = 'true';
            issueForm.appendChild(signatureVerified);

            // Disable the "unsaved changes" warning
            window.onbeforeunload = null;
            if (typeof observeFormChanges === 'function') {
              // Redmine uses this to track form changes
              issueForm.setAttribute('data-warn-on-leave', 'false');
            }

            // Submit the form
            issueForm.submit();
          }
        }
      });
    }

    function interceptFormSubmit() {
      var issueForm = document.getElementById('issue-form');
      if (!issueForm) return;

      issueForm.addEventListener('submit', function(e) {
        var statusSelect = document.getElementById('issue_status_id');
        if (!statusSelect) return;

        var selectedOption = statusSelect.options[statusSelect.selectedIndex];
        var newStatusName = selectedOption ? selectedOption.text : '';

        if (isSignatureRequired(newStatusName)) {
          e.preventDefault();
          e.stopPropagation();
          pendingStatusChange = newStatusName;
          showModal();
          return false;
        }
      });
    }

    function initModal() {
      var modal = getModal();
      if (!modal) return;

      // Close button (X)
      var closeBtn = modal.querySelector('.lab-flow-modal-close');
      if (closeBtn) {
        closeBtn.onclick = function(e) {
          e.preventDefault();
          e.stopPropagation();
          hideModal();
        };
      }

      // Cancel button
      var cancelBtn = document.getElementById('signature-cancel');
      if (cancelBtn) {
        cancelBtn.onclick = function(e) {
          e.preventDefault();
          e.stopPropagation();
          hideModal();
        };
      }

      // Overlay click
      var overlay = modal.querySelector('.lab-flow-modal-overlay');
      if (overlay) {
        overlay.onclick = function(e) {
          e.preventDefault();
          e.stopPropagation();
          hideModal();
        };
      }

      // Submit button
      var submitBtn = document.getElementById('signature-submit');
      if (submitBtn) {
        submitBtn.onclick = function(e) {
          e.preventDefault();
          e.stopPropagation();
          submitFormWithSignature();
        };
      }

      // Enter key in password field
      var passwordField = document.getElementById('signature_password');
      if (passwordField) {
        passwordField.onkeypress = function(e) {
          if (e.key === 'Enter') {
            e.preventDefault();
            submitFormWithSignature();
          }
        };
      }

      // Escape key to close
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && isModalVisible()) {
          hideModal();
        }
      });

      // Intercept form submission
      interceptFormSubmit();
    }

    // Initialize when DOM is ready
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initModal);
    } else {
      initModal();
    }
  })();
</script>
<% end %>
