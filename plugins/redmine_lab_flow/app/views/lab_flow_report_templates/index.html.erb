<h2><%= l(:label_report_templates) %></h2>

<p><%= link_to l(:label_report_template_new), new_lab_flow_report_template_path, class: 'icon icon-add' %></p>

<% if @templates.any? %>
  <table class="list">
    <thead>
      <tr>
        <th><%= l(:field_name) %></th>
        <th><%= l(:label_report_type) %></th>
        <th><%= l(:field_tracker) %></th>
        <th><%= l(:label_include_eln) %></th>
        <th><%= l(:label_include_signatures) %></th>
        <th><%= l(:label_active) %></th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @templates.each do |template| %>
        <tr class="<%= cycle('odd', 'even') %> <%= 'inactive' unless template.active? %>">
          <td><%= link_to template.name, edit_lab_flow_report_template_path(template) %></td>
          <td><%= l("label_report_type_#{template.report_type}") %></td>
          <td><%= template.tracker&.name || '-' %></td>
          <td><%= template.include_eln_narrative? ? l(:general_text_Yes) : l(:general_text_No) %></td>
          <td><%= template.include_signatures? ? l(:general_text_Yes) : l(:general_text_No) %></td>
          <td><%= template.active? ? l(:label_active) : l(:label_inactive) %></td>
          <td class="buttons">
            <%= link_to l(:button_edit), edit_lab_flow_report_template_path(template), class: 'icon icon-edit' %>
            <%= link_to l(:button_delete), lab_flow_report_template_path(template), method: :delete, data: { confirm: l(:text_are_you_sure) }, class: 'icon icon-del' %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="nodata"><%= l(:label_no_data) %></p>
<% end %>
